// ── SKILL 關鍵字路由 ─────────────────────────────────────

function getSkillsForMessage(message) {
  const msg = message.toLowerCase();

  const lubricant_kw = ['油', '潤滑', '脂', '齒輪', '液壓', '氣壓', 'dầu', 'mỡ', 'bôi trơn', 'hydraulic', 'gear'];
  const bearing_kw = ['培林', '軸承', '零件', '規格', '仿品', 'vòng bi', 'linh kiện', 'bearing'];
  const maintenance_kw = ['維修', '送修', '廠商', '報價', '合約', 'sửa chữa', 'bảo trì', 'repair'];
  const dispute_kw = ['糾紛', '賠償', '責任', '付錢', 'tranh chấp', 'bồi thường', 'dispute'];
  const textile_kw = ['新品', '開發', '客戶', 'tpu', '貼合', 'sản phẩm mới', '紡織', '產品'];
  const sewing_kw = ['車縫', '針距', '縫線', '方框', 'may', 'đường may', '針', '縫'];
  const improve_kw = ['改善', '效果', '指標', 'cải thiện', 'chỉ số', '假性', '數字'];
  const quotation_kw = ['報價單', '合約', '條款', '付款', 'báo giá', 'hợp đồng'];
  const dye_kw = ['染料', '染色', '跳燈', '色花', 'pfas', '三原色', '分光儀', 'dystar', 'deon', '儒林', '永光', 'thuốc nhuộm', 'nhảy màu'];
  const color_kw = ['標準樣', 'std', '缸差', '色號', '對色', '色差', 'delta e', 'ΔE', '校準', '色板', '色光', '跨廠', 'bản màu chuẩn'];

  const matched = new Set();

  if (lubricant_kw.some(kw => msg.includes(kw))) matched.add('lubricant');
  if (bearing_kw.some(kw => msg.includes(kw))) { matched.add('bearing_inspection'); matched.add('supplier_mgmt'); }
  if (maintenance_kw.some(kw => msg.includes(kw))) { matched.add('maintenance_handoff'); matched.add('quotation'); }
  if (quotation_kw.some(kw => msg.includes(kw))) matched.add('quotation');
  if (dispute_kw.some(kw => msg.includes(kw))) matched.add('dispute');
  if (textile_kw.some(kw => msg.includes(kw))) matched.add('textile_dev');
  if (sewing_kw.some(kw => msg.includes(kw))) matched.add('sewing');
  if (improve_kw.some(kw => msg.includes(kw))) matched.add('false_improvement');
  if (dye_kw.some(kw => msg.includes(kw))) matched.add('dye_replacement');
  if (color_kw.some(kw => msg.includes(kw))) matched.add('color_calibration');
  const tape_quote_kw = ['報價', '詢價', '多少錢', '盤頭', '廢紗', '分條', '改機', '織造', 'báo giá', 'mm帶', 'mm 帶'];

  if (tape_quote_kw.some(kw => msg.includes(kw))) matched.add('tape_quote');

  if (matched.size === 0) {
    return Object.values(SKILLS).join('\n\n---\n\n');
  }

  return [...matched].map(k => SKILLS[k]).join('\n\n---\n\n');
}
